# The same Supabase project the portal uses. One database, two
# applications — the portal writes and this reads.
NEXT_PUBLIC_SUPABASE_URL=https://qvriwjipnradsbilepyd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Both values are safe here. The anon key is designed to be public and
# every table is behind row level security, which is why this site can
# only see what is published.
#
# NEVER put the service role key in this file. It bypasses row level
# security entirely and this application has no use for it.

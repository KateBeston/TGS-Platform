# The same Supabase project the portal uses. One database, two
# applications — the portal writes and this reads.
NEXT_PUBLIC_SUPABASE_URL=https://qvriwjipnradsbilepyd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Both values are safe here. The anon key is designed to be public and
# every table is behind row level security, which is why this site can
# only see what is published.
#
# The service-role key is used by ONE path only: the server-side booking
# write in app/actions/submitBooking.ts, which recomputes every price itself
# and then writes orders, bookings, booking_items and the legal acceptance
# records. It bypasses row level security entirely.
#
# Set it in Vercel as a server environment variable. Never expose it to the
# browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
